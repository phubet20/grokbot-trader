# Copy to .env (optional) or export in the shell. All values have safe defaults.
APP_NAME="Grok Bot"
PORT=8787
# HOST=0.0.0.0          # to open the UI from your phone on the same Wi-Fi
START_USD=81            # paper wallet starting balance (min 2)
POSITION_PCT=8          # % of portfolio per trade (tiny books still size all-in after reserve)
# HARD_STOP_PCT=6
# TRAILING_STOP_PCT=7
# TAKE_PROFIT_PCT=2
# MAX_HOLD_MIN=8
# RED_EXIT_SEC=35
# MIN_SCORE=50
DATA_SOURCE=live        # live = real market data | replay = offline synthetic market
# REPLAY_SPEED=6        # replay: simulated minutes per real minute
# RPC_URL=https://api.mainnet-beta.solana.com
#
# Paper and live-auto share the same entry/exit profile (momentum scalp).
# Run TEST first; switch to LIVE in the app only after the host is armed.
#
# ---- LIVE TRADING (Phantom approve each swap) ------------------------------
# MODE=live
# LIVE_CONFIRM="I UNDERSTAND REAL FUNDS ARE AT RISK"
# Never put a private key / seed phrase anywhere. Swaps are signed in Phantom.

# ---- LIVE AUTO (bot wallet signs) ------------------------------------------
# MODE=live-auto
# LIVE_CONFIRM="I UNDERSTAND REAL FUNDS ARE AT RISK"
# BOT_WALLET_SECRET=   # base58 of the 64-byte secret key. NEVER commit this.
# WITHDRAW_TO=         # optional locked destination (otherwise first signed Phantom lock)
# KEEPALIVE_URL=       # optional; defaults to RENDER_EXTERNAL_URL/healthz
# RPC_URL=https://api.mainnet-beta.solana.com
#
# After you pause the bot, AUTO_START is set off so it stays paused across restarts
# until you start it again in the app.
